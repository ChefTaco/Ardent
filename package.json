{
  "name": "@hivemagnus/ardent",
  "version": "2.2.1",
  "description": "Headless TypeScript agent runtime with A2A, scheduled jobs, skills, chat channels, and a plugin API",
  "keywords": [
    "agent",
    "ai-agent",
    "a2a",
    "agent-runtime",
    "llm",
    "llama.cpp",
    "codex",
    "telegram",
    "mattermost",
    "scheduler"
  ],
  "author": "ChefTaco",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/Ardent.git"
  },
  "homepage": "https://github.com/ChefTaco/Ardent#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/Ardent/issues"
  },
  "type": "module",
  "bin": {
    "ardent": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^24.22.1 || ^26.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "profiles/assistant",
    "protocol",
    "model-policy.default.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/interop/**'",
    "interop:test": "vitest run test/interop",
    "interop": "node scripts/run-interop.mjs",
    "lint": "eslint src test",
    "protocol:check": "node scripts/verify-protocol.mjs",
    "openapi:check": "npm run build && node scripts/check-openapi.mjs",
    "openapi:write": "npm run build && node scripts/check-openapi.mjs --write",
    "pack:check": "node scripts/check-package.mjs",
    "cli:check": "npm run build && node scripts/check-cli.mjs",
    "chat:check": "npm run build && node scripts/check-chat.mjs",
    "schedule:check": "npm run build && node scripts/check-schedule.mjs",
    "native:check": "npm run build && node scripts/check-native.mjs",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "check:private": "bash scripts/check-private-data.sh",
    "privacy:test": "node --test scripts/test-privacy-policy.mjs scripts/test-publish-environment.mjs scripts/test-publish-package.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify": "npm run privacy:test && npm run scan:secrets && npm run check:private && npm run protocol:check && npm run typecheck && npm run lint && npm test && npm run build && npm run openapi:check && npm run pack:check"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@bufbuild/protobuf": "2.16.0",
    "@grpc/grpc-js": "1.14.7",
    "@hivemagnus/emberfold": "0.1.0",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "5.3.0",
    "hono": "^4.13.16",
    "pdfmake": "0.3.13",
    "ws": "^8.22.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/pdfmake": "0.3.3",
    "@types/ws": "^8.18.2",
    "eslint": "10.14.0",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "minimatch": "11.0.3",
    "@redocly/openapi-core": "1.34.22",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
